# ---------------------------------------------------------------
# Discord Configuration
# ---------------------------------------------------------------

# Bot token — used by scripts/register-commands.ts to register slash commands.
# Sensitive. Never commit the real value. Store in AWS SSM Parameter Store for Lambda use.
DISCORD_BOT_TOKEN=

# Public key for Ed25519 signature verification — used by the bot Lambda.
# Not sensitive (it is a public key). Safe as a Lambda environment variable.
DISCORD_PUBLIC_KEY=

# Application ID — used by scripts/register-commands.ts.
DISCORD_APPLICATION_ID=

# Channel ID where the worker Lambda posts generated summaries.
DISCORD_SUMMARY_CHANNEL_ID=

# ---------------------------------------------------------------
# Google Chat Configuration
# ---------------------------------------------------------------

# Full URL of the GChat interactions endpoint — used as the JWT audience for
# verifying Google Chat signed requests in the GChat Lambda Authorizer (Method 1).
# Value: <API_GATEWAY_URL>/gchat-interactions
# In Google Cloud Console, set "Authentication Audience" to "HTTP endpoint URL".
GCHAT_ENDPOINT_URL=

# ---------------------------------------------------------------
# AWS Configuration
# ---------------------------------------------------------------

# AWS region where DynamoDB tables and Lambda functions are deployed.
AWS_REGION=ap-south-1

# ---------------------------------------------------------------
# DynamoDB Table Name
# Single table design — all entity types share one table named MHP.
# In production this is injected automatically by SST at deploy time.
# Set manually for local development scripts that talk to DynamoDB directly.
# ---------------------------------------------------------------

MHP_TABLE=

# ---------------------------------------------------------------
# SQS
# ---------------------------------------------------------------

# SQS queue URL — used by the bot Lambda to enqueue async summary jobs.
# Injected by SST at deploy time.
SUMMARY_QUEUE_URL=
